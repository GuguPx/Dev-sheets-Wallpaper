    {
      "id": "scp",
      "title": "Copiar arquivo (scp)",
      "command": "scp arquivo.txt usuario@host:/destino/",
      "description": "Copia arquivos entre máquinas local e remota por SSH.",
      "category": "copia",
      "tags": ["copiar", "transferir"],
      "difficulty": "basico",
      "platforms": ["linux", "macos", "windows"],
      "risk": "seguro",
      "examples": [
        { "level": "basico", "code": "scp usuario@host:/remoto/arq.txt .", "explanation": "Baixa um arquivo remoto para o diretório atual." }
      ],
      "arguments": [
        { "flag": "-r", "description": "Copia diretórios recursivamente." },
        { "flag": "-P", "description": "Porta (maiúsculo no scp)." }
      ],
      "warnings": ["Sobrescreve o destino sem avisar."],
      "relatedCommands": ["rsync", "sftp"]
    },
    {
      "id": "rsync-ssh",
      "title": "Sincronizar (rsync)",
      "command": "rsync -avz -e ssh ./ usuario@host:/destino/",
      "description": "Sincroniza diretórios de forma incremental sobre SSH, transferindo apenas diferenças.",
      "category": "copia",
      "tags": ["sincronizar", "incremental", "backup"],
      "difficulty": "intermediario",
      "platforms": ["linux", "macos"],
      "risk": "atencao",
      "examples": [
        {
          "level": "avancado",
          "code": "rsync -avz --delete ./ usuario@host:/destino/",
          "explanation": "Espelha a origem, removendo no destino o que não existe mais na origem."
        }
      ],
      "arguments": [
        { "flag": "-a", "description": "Modo arquivo (preserva permissões, links, tempos)." },
        { "flag": "-z", "description": "Comprime durante a transferência." },
        { "flag": "--delete", "description": "Remove no destino arquivos ausentes na origem." }
      ],
      "warnings": ["--delete apaga arquivos no destino; teste antes com --dry-run."],
      "relatedCommands": ["scp", "sftp"]
    },
