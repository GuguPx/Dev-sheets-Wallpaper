  "entries": [
    {
      "id": "docker-run",
      "title": "Executar container",
      "command": "docker run <imagem>",
      "description": "Cria e inicia um container a partir de uma imagem, baixando-a do registro se necessário.",
      "category": "Containers",
      "tags": ["run", "container", "iniciar"],
      "difficulty": "basico",
      "platforms": ["all"],
      "risk": "seguro",
      "examples": [
        { "level": "basico", "code": "docker run hello-world", "explanation": "Executa a imagem de teste do Docker." },
        { "level": "intermediario", "code": "docker run -d -p 8080:80 --name web nginx", "explanation": "Sobe nginx em segundo plano, publicando a porta 80 em 8080." }
      ],
      "arguments": [
        { "flag": "-d", "description": "Modo desacoplado (background)." },
        { "flag": "-p <host>:<cont>", "description": "Publica uma porta." },
        { "flag": "--name", "description": "Nomeia o container." },
        { "flag": "--rm", "description": "Remove o container ao encerrar." },
        { "flag": "-e", "description": "Define variável de ambiente." }
      ],
      "warnings": [],
      "relatedCommands": ["docker ps", "docker stop"],
      "documentationUrl": "https://docs.docker.com/reference/cli/docker/container/run/"
    },
    {
      "id": "docker-ps",
      "title": "Listar containers",
      "command": "docker ps",
      "description": "Lista os containers em execução, com id, imagem, portas e status.",
      "category": "Containers",
      "tags": ["ps", "listar", "status"],
      "difficulty": "basico",
      "platforms": ["all"],
      "risk": "seguro",
      "examples": [
        { "level": "basico", "code": "docker ps", "explanation": "Mostra os containers ativos." },
        { "level": "intermediario", "code": "docker ps -a", "explanation": "Inclui containers parados." }
      ],
      "arguments": [
        { "flag": "-a", "description": "Inclui containers parados." },
        { "flag": "-q", "description": "Mostra apenas os IDs." }
      ],
      "warnings": [],
      "relatedCommands": ["docker run", "docker rm"],
      "documentationUrl": "https://docs.docker.com/reference/cli/docker/container/ls/"
    },
    {
      "id": "docker-exec",
      "title": "Executar comando em container",
      "command": "docker exec -it <container> <cmd>",
      "description": "Executa um comando dentro de um container em execução, útil para abrir um shell interativo.",
      "category": "Containers",
      "tags": ["exec", "shell", "bash"],
      "difficulty": "intermediario",
      "platforms": ["all"],
      "risk": "seguro",
      "examples": [
        { "level": "basico", "code": "docker exec -it web sh", "explanation": "Abre um shell dentro do container web." },
        { "level": "intermediario", "code": "docker exec -it db psql -U postgres", "explanation": "Abre o psql dentro do container do banco." }
      ],
      "arguments": [
        { "flag": "-i", "description": "Mantém a entrada padrão aberta (interativo)." },
        { "flag": "-t", "description": "Aloca um pseudo-terminal." }
      ],
      "warnings": [],
      "relatedCommands": ["docker attach", "docker logs"],
      "documentationUrl": "https://docs.docker.com/reference/cli/docker/container/exec/"
    },
    {
      "id": "docker-stop",
      "title": "Parar container",
      "command": "docker stop <container>",
      "description": "Envia SIGTERM ao processo principal do container e, após o timeout, SIGKILL, parando-o com segurança.",
      "category": "Containers",
      "tags": ["stop", "parar"],
      "difficulty": "basico",
      "platforms": ["all"],
      "risk": "atencao",
      "examples": [
        { "level": "basico", "code": "docker stop web", "explanation": "Para o container web." },
        { "level": "intermediario", "code": "docker stop $(docker ps -q)", "explanation": "Para todos os containers em execução." }
      ],
      "arguments": [
        { "flag": "-t <seg>", "description": "Segundos a esperar antes do SIGKILL." }
      ],
      "warnings": ["Processos sem tratamento de SIGTERM podem perder dados não salvos."],
      "relatedCommands": ["docker start", "docker kill"],
      "documentationUrl": "https://docs.docker.com/reference/cli/docker/container/stop/"
    },
    {
      "id": "docker-rm",
      "title": "Remover container",
      "command": "docker rm <container>",
      "description": "Remove um ou mais containers parados. Use -f para forçar a remoção de containers em execução.",
      "category": "Containers",
      "tags": ["rm", "remover"],
      "difficulty": "intermediario",
      "platforms": ["all"],
      "risk": "atencao",
      "examples": [
        { "level": "basico", "code": "docker rm web", "explanation": "Remove o container parado web." },
        { "level": "intermediario", "code": "docker rm -f $(docker ps -aq)", "explanation": "Força a remoção de todos os containers." }
      ],
      "arguments": [
        { "flag": "-f", "description": "Força a remoção mesmo em execução." },
        { "flag": "-v", "description": "Remove volumes anônimos associados." }
      ],
      "warnings": ["Remover um container apaga seu sistema de arquivos interno (dados fora de volumes se perdem)."],
      "relatedCommands": ["docker stop", "docker container prune"],
      "documentationUrl": "https://docs.docker.com/reference/cli/docker/container/rm/"
    },
    {
      "id": "docker-logs",
      "title": "Ver logs do container",
      "command": "docker logs <container>",
      "description": "Exibe a saída padrão e de erro de um container, útil para depuração.",
      "category": "Logs",
      "tags": ["logs", "debug", "saida"],
      "difficulty": "basico",
      "platforms": ["all"],
      "risk": "seguro",
      "examples": [
        { "level": "basico", "code": "docker logs web", "explanation": "Mostra os logs do container web." },
        { "level": "intermediario", "code": "docker logs -f --tail 100 web", "explanation": "Acompanha em tempo real as últimas 100 linhas." }
      ],
      "arguments": [
        { "flag": "-f", "description": "Segue a saída (follow)." },
        { "flag": "--tail <n>", "description": "Mostra apenas as últimas n linhas." },
        { "flag": "-t", "description": "Adiciona timestamps." }
      ],
      "warnings": [],
      "relatedCommands": ["docker exec", "docker stats"],
      "documentationUrl": "https://docs.docker.com/reference/cli/docker/container/logs/"
    },
    {
      "id": "docker-stats",
      "title": "Monitorar uso de recursos",
      "command": "docker stats",
      "description": "Mostra o consumo de CPU, memória, rede e I/O dos containers em tempo real.",
      "category": "Inspeção",
      "tags": ["stats", "recursos", "monitorar"],
      "difficulty": "intermediario",
      "platforms": ["all"],
      "risk": "seguro",
      "examples": [
        { "level": "basico", "code": "docker stats", "explanation": "Exibe recursos de todos os containers ativos." },
        { "level": "intermediario", "code": "docker stats --no-stream", "explanation": "Mostra um snapshot único, sem atualizar." }
      ],
      "arguments": [
        { "flag": "--no-stream", "description": "Exibe uma leitura e encerra." }
      ],
      "warnings": [],
      "relatedCommands": ["docker logs", "docker inspect"],
      "documentationUrl": "https://docs.docker.com/reference/cli/docker/container/stats/"
    },
    {
      "id": "docker-inspect",
      "title": "Inspecionar objeto",
      "command": "docker inspect <objeto>",
      "description": "Retorna metadados detalhados em JSON de containers, imagens, volumes ou redes.",
