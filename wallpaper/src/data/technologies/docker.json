      ],
      "arguments": [],
      "warnings": ["Confirme que a imagem não contém segredos antes de publicá-la."],
      "relatedCommands": ["docker login", "docker tag"],
      "documentationUrl": "https://docs.docker.com/reference/cli/docker/image/push/"
    },
    {
      "id": "docker-login",
      "title": "Autenticar em registro",
      "command": "docker login <registro>",
      "description": "Autentica no registro para permitir pull e push de imagens privadas.",
