    {
      "id": "docker-pull",
      "title": "Baixar imagem",
      "command": "docker pull <imagem>:<tag>",
      "description": "Baixa uma imagem de um registro (por padrão o Docker Hub) para uso local.",
      "category": "Imagens",
      "tags": ["pull", "baixar", "registro"],
      "difficulty": "basico",
      "platforms": ["all"],
      "risk": "seguro",
      "examples": [
        { "level": "basico", "code": "docker pull node:20-alpine", "explanation": "Baixa a imagem do Node 20 na variante alpine." }
      ],
      "arguments": [],
      "warnings": ["Sempre fixe uma tag específica; a tag latest muda com o tempo e quebra reprodutibilidade."],
      "relatedCommands": ["docker images", "docker push"],
      "documentationUrl": "https://docs.docker.com/reference/cli/docker/image/pull/"
    },
    {
      "id": "docker-build",
      "title": "Construir imagem",
      "command": "docker build -t <nome>:<tag> .",
      "description": "Constrói uma imagem a partir de um Dockerfile no contexto atual, aplicando um nome e tag.",
      "category": "Build",
      "tags": ["build", "dockerfile", "imagem"],
      "difficulty": "intermediario",
      "platforms": ["all"],
      "risk": "seguro",
      "examples": [
        { "level": "basico", "code": "docker build -t minha-app:1.0 .", "explanation": "Constrói a imagem minha-app:1.0 usando o Dockerfile atual." },
        { "level": "avancado", "code": "docker build --target prod --build-arg NODE_ENV=production -t app .", "explanation": "Build multi-stage mirando o estágio prod, com argumento de build." }
      ],
      "arguments": [
        { "flag": "-t", "description": "Define nome:tag da imagem." },
        { "flag": "-f", "description": "Aponta um Dockerfile alternativo." },
        { "flag": "--target", "description": "Constrói até um estágio específico (multi-stage)." },
        { "flag": "--build-arg", "description": "Passa argumentos de build." }
      ],
      "warnings": ["Evite copiar arquivos sensíveis; use .dockerignore para reduzir o contexto e proteger segredos."],
      "relatedCommands": ["docker buildx", "docker push"],
      "documentationUrl": "https://docs.docker.com/reference/cli/docker/buildx/build/"
    },
    {
      "id": "docker-tag",
