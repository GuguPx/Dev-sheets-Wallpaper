      "difficulty": "intermediario",
      "platforms": ["all"],
      "risk": "atencao",
      "examples": [
        { "level": "basico", "code": "docker login", "explanation": "Autentica no Docker Hub." },
        { "level": "intermediario", "code": "echo $TOKEN | docker login ghcr.io -u user --password-stdin", "explanation": "Login não interativo lendo o token da entrada padrão." }
      ],
      "arguments": [
        { "flag": "--password-stdin", "description": "Lê a senha/token da stdin (evita expor no histórico)." }
      ],
      "warnings": ["Não passe a senha em --password na linha de comando; ela fica no histórico do shell."],
      "relatedCommands": ["docker push", "docker pull"],
      "documentationUrl": "https://docs.docker.com/reference/cli/docker/login/"
    },
