      "tags": ["inspect", "json", "metadados"],
      "difficulty": "intermediario",
      "platforms": ["all"],
      "risk": "seguro",
      "examples": [
        { "level": "basico", "code": "docker inspect web", "explanation": "Mostra todos os metadados do container web." },
        { "level": "avancado", "code": "docker inspect -f '{{.NetworkSettings.IPAddress}}' web", "explanation": "Extrai apenas o IP usando um template Go." }
      ],
      "arguments": [
        { "flag": "-f", "description": "Formata a saída com um template Go." }
      ],
      "warnings": [],
      "relatedCommands": ["docker stats", "docker network inspect"],
      "documentationUrl": "https://docs.docker.com/reference/cli/docker/inspect/"
